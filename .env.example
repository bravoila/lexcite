# Set at least 12 characters; leave blank for first-run setup-code flow.
LEXCITE_ADMIN_PASSWORD=
LEXCITE_BIND=127.0.0.1
LEXCITE_PORT=8080
# When using an HTTPS reverse proxy: set LEXCITE_PUBLIC_URL to the public https
# address (session cookie is then Secure automatically; 127.0.0.1 bind optional)
# and configure HSTS in the proxy. LEXCITE_SECURE_COOKIE=1 forces Secure regardless.
LEXCITE_SECURE_COOKIE=0
LEXCITE_PUBLIC_URL=
# Analysis/chat model defaults. Choose local or api in the GUI; saved GUI values win.
MODEL_PROFILE=local
MODEL_LOCAL_PROVIDER=ollama
MODEL_LOCAL_BASE_URL=http://host.docker.internal:11434/v1
MODEL_LOCAL_NAME=qwen3:8b
MODEL_LOCAL_API_KEY=
MODEL_CLOUD_PROVIDER=dashscope
MODEL_CLOUD_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
MODEL_CLOUD_NAME=qwen-plus
MODEL_CLOUD_API_KEY=
# Legacy, optional defaults retained for older deployments.
MODEL_PROVIDER=
MODEL_BASE_URL=
MODEL_NAME=
MODEL_API_KEY=
# Embedding defaults. Set provider to dashscope/siliconflow/ollama/custom to enable.
EMBEDDING_PROVIDER=none
EMBEDDING_BASE_URL=http://host.docker.internal:11434
EMBEDDING_MODEL=
EMBEDDING_TIMEOUT=90
EMBEDDING_API_KEY=
# Reranker defaults. Set provider to dashscope/siliconflow/custom to enable.
RERANKER_PROVIDER=none
RERANKER_BASE_URL=http://reranker:8081/v1
RERANKER_MODEL=
RERANKER_TIMEOUT=90
RERANKER_API_KEY=
# Search defaults. Set provider to bocha or searxng to enable.
SEARCH_PROVIDER=none
SEARCH_BASE_URL=https://api.bochaai.com/v1
SEARCH_TIMEOUT=20
SEARCH_API_KEY=
